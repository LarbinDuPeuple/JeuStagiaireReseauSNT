rules_version = '2';
// Règles Firestore du « Stagiaire du Bout du Monde ».
// Remplace EMAIL_DU_PROF par l'adresse du compte enseignant créé dans Firebase Authentication,
// puis colle ce fichier dans la console Firebase > Firestore > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    function isProf() {
      return request.auth != null && request.auth.token.email == 'EMAIL_DU_PROF';
    }
    function rapportValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nom', 'classe', 'missions', 'fini', 'score', 'satisfaction', 'ticketsOk', 'tickets',
                               'reponsesOk', 'reponsesKo', 'minutes', 'capacites', 'erreurs', 'maj'])
        && d.nom is string && d.nom.size() <= 30
        && d.classe is string && d.classe.size() <= 20
        && d.missions is int && d.missions >= 0 && d.missions <= 4
        && d.capacites is list && d.capacites.size() <= 7
        && d.erreurs is list && d.erreurs.size() <= 5
        && d.maj == request.time;
    }

    // un document par élève (par navigateur), écrit uniquement par cet élève, lu par l'enseignant
    match /eleves/{uid} {
      allow read, delete: if isProf();
      allow create, update: if request.auth != null && request.auth.uid == uid && rapportValide();
    }

    // état de pause : un document par classe (ex. « 2nde-4 ») et un document « toutes »
    match /controle/{classe} {
      allow read: if request.auth != null;
      allow write: if isProf();
    }
  }
}
