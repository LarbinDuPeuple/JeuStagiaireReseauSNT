rules_version = '2';
// Règles Firestore du « Stagiaire du Bout du Monde ».
// Remplace EMAIL_DU_PROF par l'adresse du compte enseignant créé dans Firebase Authentication,
// puis colle ce fichier dans la console Firebase > Firestore > Règles > Publier.
service cloud.firestore {
  match /databases/{database}/documents {
    function isProf() {
      return request.auth != null && request.auth.token.email == 'EMAIL_DU_PROF';
    }
    function rapportValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nom', 'classe', 'missions', 'fini', 'score', 'satisfaction', 'ticketsOk', 'tickets',
                               'reponsesOk', 'reponsesKo', 'minutes', 'capacites', 'erreurs', 'etat', 'maj'])
        && d.nom is string && d.nom.size() <= 30
        && d.classe is string && d.classe.size() <= 20
        && d.missions is int && d.missions >= 0 && d.missions <= 8
        && d.capacites is list && d.capacites.size() <= 20
        && d.erreurs is list && d.erreurs.size() <= 5
        && d.etat is string && d.etat.size() < 200000
        && d.maj == request.time;
    }

    // une partie par élève, nommée « classe__prénom-initiale » (ex. 2nde-4__lucas-m).
    // Pas de compte élève : retaper le même prénom et la même classe suffit pour retrouver sa partie,
    // à condition de connaître le nom exact du document. Seul l'enseignant peut lister ou supprimer.
    match /parties/{cle} {
      allow get: if request.auth != null;
      allow list, delete: if isProf();
      allow create, update: if request.auth != null && rapportValide();
    }

    // mini-jeu « Routeur express » : meilleur score de chaque élève, lisible par toute la classe
    function scoreValide() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nom', 'classe', 'best', 'parties', 'maj'])
        && d.nom is string && d.nom.size() <= 30
        && d.classe is string && d.classe.size() <= 20
        && d.best is int && d.best >= 0 && d.best <= 30000
        && d.parties is int && d.parties >= 1 && d.parties <= 10000
        && d.maj == request.time;
    }
    match /scores/{cle} {
      allow read: if request.auth != null;
      allow delete: if isProf();
      allow create: if request.auth != null && scoreValide();
      allow update: if request.auth != null && scoreValide() && request.resource.data.best >= resource.data.best;
    }

    // contrôle par l'enseignant (pause, parties 2 et 3, borne d'arcade) : un document par classe (ex. « 2nde-4 »)
    // et un document « toutes »
    match /controle/{classe} {
      allow read: if request.auth != null;
      allow write: if isProf();
    }
  }
}
